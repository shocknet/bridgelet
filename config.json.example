{
  "domain": "bridgelet.clink-playground.dev",
  "port": 3000,
  "aliases": {
    "alice": {
      "nostrPubkey": "alice_public_key_hex", // Optional: Nostr public key (hex). Required for NIP-05. Also used for NIP-57 Zap Receipt signing.
      "relays": ["wss://relay.damus.io", "wss://nos.lol"], // Optional: List of relay URLs for NIP-05. Only used if nostrPubkey is also set.
      "clink_offer": "alice_clink_offer_string_noffer1...", // Required for LNURL payments via CLINK Offer. (e.g., a NIP-69 compatible 'noffer' string).
      "clink_debit": "alice_clink_debit_string_ndebit1..."  // Optional: CLINK Debit string for NIP-05 discovery.
    },
    "bob": {
      "nostrPubkey": "bob_public_key_hex",
      "clink_offer": "bob_clink_offer_string_noffer1..." // Required for LNURL payments via CLINK Offer.
      // Bob has NIP-05 & CLINK Offer, but no specific relays or CLINK Debit configured in this example.
    },
    "carol": {
      // Carol only uses LNURL-P via CLINK Offer. No NIP-05 or Zaps configured.
      "clink_offer": "carol_clink_offer_string_noffer1..." // Required for LNURL payments via CLINK Offer.
    },
    "dave": {
      "nostrPubkey": "dave_public_key_hex" // Dave is only configured for NIP-05, not for LNURL payments via CLINK.
    }
  }
}